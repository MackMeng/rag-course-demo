# ==================== RAG 项目环境变量模板 ====================
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，绝不会被提交
#
# 生效方式（二选一）：
#   PowerShell（当前会话）：  $env:DASHSCOPE_API_KEY="sk-你的key"
#   PowerShell（永久设置）：  setx DASHSCOPE_API_KEY "sk-你的key"   （设置后需重开终端）
#
# 申请地址：https://bailian.console.aliyun.com/ （阿里云百炼控制台，新用户有免费额度）

DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
